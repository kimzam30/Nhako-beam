<!-- The app's page in Linux software centres and on Flathub (AppStream). Check with:
     appstreamcli validate packaging/linux/io.github.kimzam30.nhakobeam.metainfo.xml -->
<component type="desktop-application">
  <id>io.github.kimzam30.nhakobeam</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Nhako Beam</name>
  <summary>Send files straight between your own devices</summary>
  <developer id="io.github.kimzam30">
    <name>kimzam30</name>
  </developer>
  <description>
    <p>
      Nhako Beam sends files, folders, text and links straight from one of your devices to another:
      Windows, Linux and Android. Nearby over Wi-Fi, or across the internet when you're apart.
      No cloud, no account and no size limit.
    </p>
    <ul>
      <li>Your devices find each other on the same Wi-Fi. Pair once with a four-word code to reach them from anywhere.</li>
      <li>Encrypted end to end, and every file is checked on arrival.</li>
      <li>Pause and resume, even big files, even after the connection drops.</li>
      <li>Send whole folders, notes, links and what's on your clipboard.</li>
      <li>Share via link: someone without the app downloads with their browser, after you let them in.</li>
      <li>Only your own devices can send to you, unless you choose otherwise.</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.kimzam30.nhakobeam.desktop</launchable>
  <url type="homepage">https://github.com/kimzam30/Nhako-beam</url>
  <url type="bugtracker">https://github.com/kimzam30/Nhako-beam/issues</url>
  <url type="vcs-browser">https://github.com/kimzam30/Nhako-beam</url>
