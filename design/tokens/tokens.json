          "canvas",
          "surface",
          "surfaceRaised",
          "fill"
        ],
        "min": 4.5
      },
      {
        "fg": "textTertiary",
        "bg": [
          "canvas",
          "surface",
          "surfaceRaised"
        ],
        "min": 4.5
      },
      {
        "fg": "accentText",
        "bg": [
          "canvas",
          "surface",
          "surfaceRaised",
          "accentSubtle"
        ],
        "min": 4.5
      },
      {
        "fg": "onAccent",
        "bg": [
          "accent",
          "accentPressed"
        ],
        "min": 4.5
      },
      {
        "fg": "onDanger",
        "bg": [
          "danger"
        ],
        "min": 4.5
      },
      {
        "fg": "success",
