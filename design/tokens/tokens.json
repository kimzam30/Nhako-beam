  "brand": {
    "note": "The logo's colors (docs/brand/). The same in light and dark. For the app icon, the splash and the beam glow; text uses color.accent, because white on blue only passes contrast at 1A6FE0. Never yellow text on white.",
    "blue": "#2F8FFF",
    "navy": "#1A6FE0",
    "yellow": "#FFD23F"
  },
  "contrast": {
    "note": "Pairs checked by check-contrast.mjs in both themes. 4.5 = body text (WCAG AA). 3 = icons, borders, large text and UI parts (WCAG 1.4.11).",
    "pairs": [
      {
        "fg": "textPrimary",
        "bg": [
          "canvas",
          "surface",
          "surfaceRaised",
          "fill",
          "surfaceSunken"
        ],
        "min": 4.5
      },
      {
        "fg": "textSecondary",
