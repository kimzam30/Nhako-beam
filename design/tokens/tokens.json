  "motion": {
    "spring": {
      "note": "Springs are the default for anything that moves. dampingRatio 1 = no overshoot. stiffness is in N/m with mass 1, so it matches Compose spring() and Motion's physical spring.",
      "press": {
        "dampingRatio": 1.0,
        "stiffness": 1800,
        "use": "Press and release feedback on buttons, rows, chips."
      },
      "snappy": {
        "dampingRatio": 0.9,
        "stiffness": 900,
        "use": "Toggles, checkmarks, small state flips, badge changes."
      },
      "smooth": {
        "dampingRatio": 1.0,
        "stiffness": 400,
        "use": "Default. Layout shifts, list reorder, sheets, cards moving."
      },
      "gentle": {
        "dampingRatio": 1.0,
        "stiffness": 180,
        "use": "Large surfaces and screen to screen transitions."
      },
      "bouncy": {
        "dampingRatio": 0.6,
        "stiffness": 500,
        "use": "Arrival and success moments only: device appears, transfer accepted, done."
      },
      "magnet": {
        "dampingRatio": 0.75,
        "stiffness": 650,
        "use": "Dragged files pulled toward a target; elements following a finger."
      },
      "settle": {
        "dampingRatio": 0.8,
        "stiffness": 350,
        "use": "Snap back or fly out after a swipe is released. Carries the release velocity."
      }
    },
    "duration": {
      "note": "Only for things that do not move: fades, color changes, ambient loops.",
      "instant": 90,
      "fast": 150,
      "base": 220,
      "slow": 320,
      "slower": 480,
      "radarSweep": 2400,
      "searchingPulse": 1600
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "enter": [
        0,
        0,
        0,
        1
      ],
      "exit": [
        0.3,
        0,
        1,
        1
      ],
      "linear": [
        0,
        0,
        1,
        1
      ]
    },
    "stagger": {
      "step": 30,
      "maxItems": 6
    },
    "scale": {
      "pressed": 0.97,
      "lifted": 1.02,
      "dropTargetHover": 1.08,
      "enterFrom": 0.94
    },
    "distance": {
      "enterOffset": 12,
      "toastOffset": 24
    },
    "bolt": {
      "note": "The bolt language from the logo: charge, zap, settle. Sparks are tiny bolts thrown from a point when something commits. Nothing here loops. Reduced motion skips sparks, arcs and cracks.",
      "sparkCount": 5,
      "sparkReach": 32,
      "sparkSize": 14,
      "sparkMs": 300,
      "flashMs": 320,
      "arcMs": 420,
      "morphMs": 360
    },
    "mascot": {
      "note": "The voxel mascot (design/mascot/). Idle is calm: a breath and a blink every few seconds, never anything faster. Moments (found, done, failed) show for a while, then it goes back to idle. Reduced motion holds a still pose instead.",
      "blinkMinMs": 2600,
      "blinkMaxMs": 5200,
      "blinkMs": 140,
      "breatheMs": 3200,
      "followDeg": 26,
      "foundMs": 1400,
      "doneMs": 2600,
      "failedMs": 3200
    }
  },
  "gesture": {
    "dragSlopPointer": 4,
    "dragSlopTouch": 8,
    "swipeCommitFraction": 0.4,
    "swipeCommitVelocity": 650,
    "swipeMaxRotationDeg": 6,
    "swipeFlyOutVelocityMin": 1200,
    "rubberBandCoefficient": 0.55,
    "magnetRadius": 120,
    "magnetSnapRadius": 44,
    "magnetPull": 0.35,
    "longPressMs": 420,
    "sheetDismissFraction": 0.3,
    "sheetDismissVelocity": 900
  },
  "haptic": {
    "note": "Android only. Value = HapticFeedbackConstants name, fallback used below its API level. 'none' means stay silent on purpose.",
    "dragStart": {
      "android": "DRAG_START",
      "minApi": 34,
      "fallback": "LONG_PRESS"
    },
    "thresholdActivate": {
      "android": "GESTURE_THRESHOLD_ACTIVATE",
      "minApi": 34,
      "fallback": "CLOCK_TICK"
    },
    "thresholdDeactivate": {
      "android": "GESTURE_THRESHOLD_DEACTIVATE",
      "minApi": 34,
      "fallback": "CLOCK_TICK"
    },
    "magnetSnap": {
      "android": "SEGMENT_TICK",
      "minApi": 34,
      "fallback": "CLOCK_TICK"
    },
    "accept": {
      "android": "CONFIRM",
      "minApi": 30,
      "fallback": "VIRTUAL_KEY"
    },
    "decline": {
      "android": "REJECT",
      "minApi": 30,
      "fallback": "LONG_PRESS"
    },
    "transferDone": {
      "android": "CONFIRM",
      "minApi": 30,
      "fallback": "VIRTUAL_KEY"
    },
    "transferFailed": {
      "android": "REJECT",
      "minApi": 30,
      "fallback": "LONG_PRESS"
    },
    "pairMatched": {
      "android": "CONFIRM",
      "minApi": 30,
      "fallback": "VIRTUAL_KEY"
    },
    "toggleOn": {
      "android": "TOGGLE_ON",
      "minApi": 34,
      "fallback": "CLOCK_TICK"
    },
    "toggleOff": {
      "android": "TOGGLE_OFF",
      "minApi": 34,
      "fallback": "CLOCK_TICK"
    },
    "buttonPress": {
      "android": "none",
      "minApi": 0,
      "fallback": "none"
    },
    "progressTick": {
      "android": "none",
      "minApi": 0,
      "fallback": "none"
    }
  },
  "depth": {
    "note": "How deep the 3D UI goes. The Home stage is a real 3D scene (design/mascot/build/mascot.json, stage); these are for the flat UI around it: sheets and cards lift and tilt a little toward the pointer, never more than tiltMaxDeg. Reduced motion keeps them flat and still.",
    "tiltMaxDeg": 2.5,
    "perspective": 1100,
    "liftPx": 4,
    "liftHoverPx": 8
  }
}
