<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nhako" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>
    <!-- Cold start: brand blue and the bolt, then MainActivity switches to Theme.Nhako. -->
    <style name="Theme.Nhako.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_bolt</item>
        <item name="postSplashScreenTheme">@style/Theme.Nhako</item>
    </style>
    <!-- Quick send: no window of its own, the Send sheet slides up over the app that shared. -->
    <style name="Theme.Nhako.QuickSend" parent="Theme.Nhako">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <color name="canvas">#F4F5F7</color>
    <color name="icon_background">#3F86F0</color>
</resources>
