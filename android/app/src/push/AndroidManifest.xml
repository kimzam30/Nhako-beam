<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app's manifest in every build except F-Droid's (-Pnhako.fdroid), which has no Firebase. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Wake-up pushes from your other devices (wake/README.md). Idle without Firebase set up. -->
        <service
            android:name=".platform.WakeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
