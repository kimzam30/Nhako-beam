# Copy this file to .env and fill it in.

# The relay token. Every device that uses your relay needs the same one.
# Make a long random one, for example:  openssl rand -hex 24
NHAKO_RELAY_TOKEN=

# Ports on this computer. Change them if something else already uses them.
NHAKO_RELAY_PORT=3340
NHAKO_LOOKUP_PORT=3341
