{
  "name": "nhako-beam-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nhako Beam desktop app: the Svelte UI (also runs in a browser on a pretend engine) and the Tauri shell in src-tauri/ that runs the real engine.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "tokens": "node ../design/tokens/build.mjs",
    "sounds": "node ../design/sounds/build.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "tauri": "tauri",
    "test:app": "node tests/app/real-engine.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "motion": "14.1.0",
    "svelte": "5.57.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@tsconfig/svelte": "5.0.8",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
