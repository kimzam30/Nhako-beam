{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nhako Beam",
  "mainBinaryName": "nhako-beam",
  "version": "0.1.0",
  "identifier": "io.github.kimzam30.nhakobeam",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nhako Beam",
        "width": 1080,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "publisher": "kimzam30",
    "copyright": "MIT OR Apache-2.0",
    "license": "MIT OR Apache-2.0",
    "shortDescription": "Send files between your devices",
    "longDescription": "Nhako Beam sends files straight between your Windows, Linux and Android devices: nearby over Wi-Fi, or across the internet, encrypted end to end.",
    "homepage": "https://github.com/kimzam30/Nhako-beam"
  }
}
